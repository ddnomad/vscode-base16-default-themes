{
  "name": "vscode-base16-default-themes",
  "displayName": "Base16 Default Themes",
  "description": "An opinionated, more minimal take on Base16 Default Dark and Light themes for VS Code",
  "version": "0.1.0",
  "publisher": "ddnomad",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#181818",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ddnomad/vscode-base16-default-themes.git"
  },
  "homepage": "https://github.com/ddnomad/vscode-base16-default-themes#readme",
  "bugs": {
    "url": "https://github.com/ddnomad/vscode-base16-default-themes/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "scripts": {
    "package:local": "vsce package --out base16-default-themes-local.vsix",
    "install:cursor": "npm run package:local && cursor --install-extension base16-default-themes-local.vsix --force",
    "install:vscode": "npm run package:local && code --install-extension base16-default-themes-local.vsix --force"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "base16",
    "dark",
    "light",
    "minimal",
    "theme"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Base16 Default Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/base16-default-dark.json"
      },
      {
        "label": "Base16 Default Light",
        "uiTheme": "vs",
        "path": "./themes/base16-default-light.json"
      }
    ]
  }
}
